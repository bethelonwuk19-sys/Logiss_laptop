{
  "expo": {
    "name": "LOGISS Field",
    "slug": "logiss-field",
    "version": "1.0.0",
       "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1a3c6e",
      "resizeMode": "contain"
    },
    "android": {
      "package": "org.logiss.field",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "org.logiss.field",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph students and laptops during registration."
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LOGISS needs camera access to photograph students and laptops during registration."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5c42b5d6-cce3-4734-848d-1ac97680f797"
      }
    },
    "owner": "smartchuksempires-team"
  }
}
